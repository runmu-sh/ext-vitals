{
  "name": "@runmu.sh/ext-vitals",
  "version": "1.1.0",
  "description": "Gauges for GMCP Char.Vitals (hp, mana, essence, moves) on the widget layer, in theme colours. Partial updates merge.",
  "keywords": [
    "vitals",
    "gauges",
    "hp",
    "mana",
    "gmcp"
  ],
  "license": "MIT",
  "homepage": "https://runmu.sh/marketplace/x/vitals",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runmu-sh/ext-vitals.git"
  },
  "bugs": {
    "url": "https://github.com/runmu-sh/ext-vitals/issues"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "schema",
    "src/types.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/build.mjs --check",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@muclient/sdk": "npm:@runmu.sh/sdk@^1.12.0",
    "@runmu.sh/dev": "^0.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "muclient": {
    "id": "vitals",
    "api": "^1.12",
    "source": "src/index.ts",
    "displayName": "Vitals",
    "description": "Gauges for GMCP Char.Vitals (hp, mana, essence, moves) on the widget layer, in theme colours. Partial updates merge.",
    "categories": [
      "interface",
      "combat"
    ],
    "contributes": {
      "gmcp": [
        {
          "package": "Char 1",
          "messages": {
            "Char.Vitals": {
              "dir": "in",
              "schema": "schema/vitals.json"
            }
          }
        }
      ]
    },
    "capabilities": [],
    "publisher": "bitmuse"
  },
  "types": "./src/types.ts"
}
