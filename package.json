{
  "name": "@runmu.sh/ext-vitals",
  "version": "1.0.1",
  "description": "Gauges for GMCP Char.Vitals (hp, mana, essence, moves) on the widget layer, in theme colours.",
  "keywords": [
    "vitals",
    "gauges",
    "hp",
    "mana",
    "gmcp"
  ],
  "license": "MIT",
  "homepage": "https://runmu.sh/marketplace/x/vitals",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runmu-sh/ext-vitals.git"
  },
  "bugs": {
    "url": "https://github.com/runmu-sh/ext-vitals/issues"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/build.mjs --check"
  },
  "devDependencies": {
    "@muclient/sdk": "npm:@runmu.sh/sdk@^1.6.0",
    "@runmu.sh/dev": "^0.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "muclient": {
    "id": "vitals",
    "api": "^1.1",
    "source": "src/index.ts",
    "displayName": "Vitals",
    "description": "Gauges for GMCP Char.Vitals (hp, mana, essence, moves) on the widget layer, in theme colours.",
    "categories": [
      "interface",
      "combat"
    ],
    "contributes": {
      "gmcp": [
        "Char 1"
      ]
    },
    "capabilities": [
      "read-output"
    ],
    "publisher": "bitmuse"
  }
}
